# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / tooling
.pytest_cache/
.coverage
htmlcov/

# Generated site output. Keep the dir.
site/*
!site/.gitkeep

# Local env
.env
*.local

# OS
.DS_Store

# Generated dated reports. Keep the dir.
reports/*
!reports/.gitkeep

# Everything under data/ is local (the card-log store, caches, odds, line-ups).
data/*
!data/.gitkeep
